# Copy this file to .env and fill in real keys.

# Pipeline: Ark grounding/features -> bbox crop -> Seedream 45-degree reference -> Hunyuan 3D
DETECTION_PROVIDER=ark_grounding
SEGMENTATION_PROVIDER=mock
MODEL3D_PROVIDER=feature_hunyuan

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VISION_MODEL=doubao-seed-2-1-pro-260628
ARK_TEXT_MODEL=doubao-seed-2-1-pro-260628
ARK_TEXT_MODEL=doubao-seed-2-1-pro-260628
ARK_IMAGE_MODEL=doubao-seedream-5-0-lite-260128
ARK_IMAGE_SIZE=2048x2048
ENABLE_ARK_REFERENCE_IMAGE=false
SPATIAL_AGENT_PROVIDER=ark

# Skill-based user floorplan advice (OpenAI-compatible DeepSeek API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
SKILL_ADVICE_TIMEOUT_SEC=90

# Per-video furniture deduplication. The CLIP model is downloaded on first use.
FURNITURE_DEDUPE_ENABLED=true
FURNITURE_DEDUPE_MODEL=openai/clip-vit-base-patch32
FURNITURE_DEDUPE_DEVICE=auto
FURNITURE_DEDUPE_THRESHOLD=0.88
FURNITURE_DEDUPE_BATCH_SIZE=16

HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com
HUNYUAN_MODEL=hy-3d-3.1
HUNYUAN_GENERATE_TYPE=Normal
HUNYUAN_ENABLE_PBR=false
HUNYUAN_ENABLE_GEOMETRY=false
HUNYUAN_RESULT_FORMAT=GLB
HUNYUAN_POLL_INTERVAL_SEC=5
HUNYUAN_POLL_ATTEMPTS=120

TRIPO_API_KEY=
TRIPO_BASE_URL=https://api.tripo3d.com
TRIPO_MODEL_VERSION=v3.0-20250812
TRIPO_TEXTURE=true
TRIPO_PBR=false
TRIPO_TEXTURE_QUALITY=standard
TRIPO_TEXTURE_ALIGNMENT=geometry
TRIPO_EXPORT_UV=false
TRIPO_ENABLE_IMAGE_AUTOFIX=false
TRIPO_POLL_INTERVAL_SEC=5
TRIPO_POLL_ATTEMPTS=72

# Optional alternate remote provider (not the verified local chain)
# MODEL3D_PROVIDER=hunyuan3d

# Optional SAM refinement. Keep mock to skip SAM and use the Ark bbox crop/mask.
# SEGMENTATION_PROVIDER=sam3
# SAM3_ENDPOINT=https://your-sam-service.example.com
# SAM3_API_KEY=

# Professional models only (hy-3d-3.0 / hy-3d-3.1):
# HUNYUAN_GENERATE_TYPE=LowPoly
# Leave HUNYUAN_FACE_COUNT unset to use the provider default without the
# custom FaceCount add-on. Set 3000-1500000 only when a custom budget is needed.
# HUNYUAN_FACE_COUNT=
